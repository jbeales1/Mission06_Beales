@{
}
@{
}
<!--Page that displays all the movies in Joel's collection-->

@model List<Movie>

<table class="table table-bordered">

	<thead class="fw-bold">
		<tr>
			<!--column names-->
			<td>CategoryName</td>
			<td>Title</td>
			<td>Year</td>
			<td>Director</td>
			<td>Rating</td>
			<td>Edited</td>
			<td>LentTo</td>
			<td>CopiedToPlex</td>
			<td>Notes</td>
		</tr>

	</thead>

	<!--for loop that displays each database row-->
	@foreach (var x in Model)
	{
		<!--the at sign means C# code. we use a capital M to refer to the specific instance of the model that's come in -->
		<tbody>
			<tr>
				<td>@x.Category?.CategoryName</td>
				<td>@x.Title</td>
				<td>@x.Year</td>
				<td>@x.Director</td>
				<td>@x.Rating</td>
				<td>@x.Edited</td>
				<td>@x.LentTo</td>
				<td>@x.CopiedToPlex</td>
				<td>@x.Notes</td>

				<td><a class="btn btn-info" asp-controller="Home" asp-action="Edit" asp-route-id="@x.MovieId">Edit</a></td>
				<td><a class="btn btn-danger" asp-controller="Home" asp-action="Delete" asp-route-id="@x.MovieId">Delete</a></td>
			</tr>
		</tbody>
	}


</table>
